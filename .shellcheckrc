# Project convention: every lib/*.sh file begins with a "load guard" of the
# form `if [ -n "$X_LOADED" ]; then return 0 2>/dev/null || exit 0; fi`, and
# nearly all variables are defined in one sourced file and consumed in
# another at runtime. ShellCheck cannot follow the dynamic `source` chain
# used by bin/wg-vpn and install.sh, so it reports these as unreachable code
# / unused variables across every file. They are false positives inherent to
# this project's module layout, not oversights - verified by cross-file grep
# during review.
disable=SC2317
disable=SC2034
disable=SC2119
disable=SC2120
disable=SC2015
disable=SC2153
